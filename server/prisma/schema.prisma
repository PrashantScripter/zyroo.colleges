generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  COUNSELOR
  PARENT
  COLLEGE_REP
}

enum ExamStatus {
  open
  upcoming
  closed
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(STUDENT)
  picture   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model College {
  id                  Int      @id @default(autoincrement())
  name                String
  location            String   // e.g., "Chennai, Tamil Nadu"
  stream              String   // Primary stream e.g., "engineering"
  category            String   // e.g., "government", "private", "deemed"
  nirfRank            Int
  naacGrade           String?  // e.g., "A++", "A+", "Exempt (IIT)"
  annualFees          Float    // Default/Base annual fees for Find/Rankings page
  rating              Float    @default(0.0) // Overall rating (e.g., 4.8)
  image               String   @db.Text

  // Additional fields required for Compare College page
  established         Int?     // e.g., 1959
  campusSize          Float?   // Campus size in Acres e.g., 617
  phdFacultyPct       Float?   // Faculty with PhD % e.g., 98
  
  // Ratings breakdown criteria
  ratingAcademics     Float?   @default(0.0)
  ratingPlacements    Float?   @default(0.0)
  ratingInfrastructure Float?  @default(0.0)
  ratingCampusLife    Float?   @default(0.0)

  // Facilities stored as JSON string array e.g., ["Research Park", "Hostels"]
  facilities          Json?

  // Relations
  courses             Course[]
  assessmentQuestions  AssessmentQuestion[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([stream])
  @@index([category])
  @@index([nirfRank])
  @@map("colleges")
}

model Course {
  id             Int     @id @default(autoincrement())
  collegeId      Int
  college        College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  key            String  // e.g., "cse", "ece" (used as key in frontend selection)
  name           String  // e.g., "B.Tech Computer Science & Engineering"
  fees           Float   // Course specific tuition fee
  hostelFees     Float   // Annual hostel & mess fee
  avgPackage     Float   // Average salary package in LPA
  medianPackage  Float   // Median salary package in LPA
  highestPackage Float   // Highest salary package in LPA
  placementRate  Float   // Placement rate percentage (e.g., 96.0)
  cutoff         String  // e.g., "JEE Rank 148"
  acceptedExams  String  // e.g., "JEE Advanced"
  duration       String  // e.g., "4 Years"
  seats          Int     // Number of seats available

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([collegeId])
  @@index([key])
  @@map("courses")
}

model AssessmentQuestion {
  id                 Int      @id @default(autoincrement())
  collegeId          Int
  college            College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  text               String   @db.Text
  options            Json // Stored as JSON array: ["O(1)", "O(n)", ...]
  correctOptionIndex Int
  explanation        String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([collegeId])
  @@map("assessment_questions")
}

model EntranceExam {
  id                   String     @id
  name                 String
  stream               String
  conductingBody       String
  mode                 String     // e.g., "Online", "Offline"
  status               ExamStatus
  registrationTimeline String     // Maps to timeline.registration in DTO
  examDatesTimeline    String     // Maps to timeline.examDates in DTO
  eligibility          String     @db.Text
  targetColleges       String     @db.Text
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  @@index([stream])
  @@index([status])
  @@map("entrance_exams")
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String?  @db.Text
  image       String   @db.Text
  category    String
  author      String
  authorType  String
  tags        Json     // ✅ store as JSON array, e.g., ["MTech", "GATE"]
  likes       Int      @default(0)
  views       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([author])
  @@map("blogs")
}

model CounselingBooking {
  id             Int      @id @default(autoincrement())
  name           String
  phone          String
  email          String
  targetCollege  String
  stream         String
  preferredDate  DateTime
  preferredTime  String   // e.g., "Morning Slot"
  concerns       String?  @db.Text
  userId         String?  // optional: link to User if logged in
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("counseling_bookings")
}